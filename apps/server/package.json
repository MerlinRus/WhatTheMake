{
  "name": "@wtm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/cli/migrate.ts",
    "db:seed:mascara": "node dist/cli/seed-mascara.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@wtm/contracts": "0.1.0",
    "@wtm/domain": "0.1.0",
    "@wtm/infrastructure": "0.1.0",
    "fastify": "5.12.1"
  }
}
