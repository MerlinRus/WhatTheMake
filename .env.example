NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
LOG_LEVEL=info
DATABASE_URL=postgresql://wtm:wtm@127.0.0.1:15432/wtm
DATABASE_POOL_MAX=10
MIGRATIONS_DIR=apps/server/migrations
MEDIA_ROOT=data/media
WEB_ROOT=apps/web/dist
MEDIA_MAX_BYTES=8388608
MEDIA_UPLOAD_RECOVERY_DELAY_MS=60000
MEDIA_RECOVERY_POLL_MS=1000
MEDIA_RECOVERY_LEASE_MS=30000
MEDIA_RECOVERY_RETRY_BASE_MS=5000
MEDIA_RECOVERY_RETRY_MAX_MS=3600000
# GOOGLE_VISION_API_KEY=replace-with-google-vision-api-key
GOOGLE_VISION_TIMEOUT_MS=10000
OCR_QUEUE_CONCURRENCY=2
OCR_QUEUE_MAX_PENDING=20
OCR_QUEUE_WAIT_TIMEOUT_MS=15000
OCR_L1_MAX_ENTRIES=128
OCR_L1_TTL_MS=300000
DEEPSEEK_ENABLED=false
# DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_TIMEOUT_MS=10000
BUILD_SHA=dev
